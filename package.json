{
  "name": "nfl-odds-board",
  "version": "1.0.0",
  "description": "DraftKings vs FanDuel NFL odds, side by side, live",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/src/server/main.js",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "demo": "tsx scripts/demo.ts",
    "probe": "tsx scripts/probe.ts",
    "measure": "tsx scripts/measure.ts",
    "test": "vitest run",
    "capture": "tsx scripts/capture.ts",
    "audit": "tsx scripts/audit.ts",
    "watch-day": "tsx scripts/watch-day.ts"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
